// Regulators and an LTC with their RegControls: reg1 (1-phase line-to-neutral, line drop compensation, after
// IEEE13_CDPSM), vr_ll (1-phase line-to-line, after IEEE37), gang (3-phase gang-operated), coded (a regulator by
// XfmrCode, reversible, after IEEE8500), ltc (a step-down LTC on winding 2, after EPRI M1).
Clear
New Circuit.atom basekv=115 bus1=sourcebus pu=1.0 MVAsc3=20000 MVAsc1=21000
New Transformer.ltc phases=3 windings=2 buses=[sourcebus sub] conns=[delta wye] kVs=[115 12.47] kVAs=[20000 20000]
~ XHL=8 %Rs=[0.5 0.5] taps=[1 1.0125]
New RegControl.ltc transformer=ltc winding=2 vreg=124 band=2 ptratio=60
New Transformer.reg1 phases=1 bank=reg buses=[sub.1 rg.1] kVs=[7.2 7.2] kVAs=[1666 1666] XHL=0.01 %LoadLoss=0.01 taps=[1 1.0625]
New RegControl.reg1 transformer=reg1 winding=2 vreg=122 band=2 ptratio=60 ctprim=700 R=3 X=9
New Transformer.vr_ll phases=1 buses=[sub.1.2 rl.1.2] kVs=[12.47 12.47] kVAs=[2000 2000] XHL=0.01 %LoadLoss=0.00001
~ conns=[delta delta] NumTaps=32 MaxTap=1.1 MinTap=0.9
New RegControl.vr_ll transformer=vr_ll winding=2 vreg=122 band=2 ptratio=104 ctprim=350 R=1.5 X=0.75
New Transformer.gang phases=3 windings=2 buses=[sub rgang] conns=[wye wye] kVs=[12.47 12.47] kVAs=[5000 5000]
~ XHL=0.01 %LoadLoss=0.002
New RegControl.gang transformer=gang winding=2 vreg=123 band=2 ptratio=60 PTphase=2 delay=30 tapdelay=5
New XfmrCode.regleg phases=1 windings=2 kVs=[7.2 7.2] kVAs=[1666 1666] XHL=0.1 %LoadLoss=0.001 MaxTap=1.1 MinTap=0.9 NumTaps=32
New Transformer.coded XfmrCode=regleg buses=[sub.3 rc.3]
New RegControl.coded transformer=coded winding=2 vreg=125 band=2 ptratio=60 reversible=yes revvreg=125 revband=2
~ revThreshold=50
