# OpenDSS Transformer -> PowerTransformer + PowerTransformerEnd per bus;
# 1-phase: TransformerTank + TransformerPhaseEnd + TransformerWinding; 3-phase: balanced ends.
# Source table: Transformer (records: 1)
# Mapping: cimhub_opendss/docs/CIMTBL_MAPPING.md#transformer

Profile = cim18v17

# untranscribed: Xscarray, thermal, n, m, flrise, hsrise, normhkVA, emerghkVA, Seasons, Ratings, normamps, emergamps,
# sub, subname, MaxTap, MinTap, NumTaps, ppm_antifloat, bank, XRConst, LeadLag, Core, RdcOhms, faultrate, pct_perm,
# repair, basefreq, like
Table PowerTransformer: mRID, name, EquipmentContainer, normallyInService
    # defaulted: conns=wye
    xf_reg1, Reg1, fdr_atom,

# 1-phase: by phase ends
Table PowerTransformerEnd: mRID, PowerTransformer, node, phases, endNumber, connectionKind, grounded, BaseVoltage
    xf_reg1_1, xf_reg1, brkr, AN, 1, Y, true, bv_4p16kv
    xf_reg1_2, xf_reg1, rg60, AN, 2, Y, true, bv_4p16kv

# derived: noLoadLoss = pct_noloadloss / 100 x winding 1 kVA
Table TransformerTank: mRID, PowerTransformer, percentMagnetizingCurrent (percent), noLoadLoss (kW)
    xf_reg1_tank, xf_reg1, ,

# sequenceNumber is unique in the transformer, end 1 first, in terminal phase order
Table TransformerPhaseEnd: mRID, endNumber, sequenceNumber, phase
    xf_reg1_1_A, 1, 1, A
    xf_reg1_1_N, 1, 2, N
    xf_reg1_2_A, 2, 3, A
    xf_reg1_2_N, 2, 4, N

# baseU = DSS kV (the coil); derived: ratedU phase-to-phase (x sqrt 3 for a phase-to-neutral coil on a 3-phase system, x 2 for a split-phase half), ratedS of a half = kVA / 2
Table TransformerWinding: mRID, TransformerTank, ratedU (kV), baseU (kV), ratedS (kVA), baseS (kVA), r (percent), FromTransformerEnd, ToTransformerEnd
    xf_reg1_wdg_1, xf_reg1_tank, 4.156921938165305, 2.4, 1666.0, 1666.0, 0.005, xf_reg1_1_A, xf_reg1_1_N
    xf_reg1_wdg_2, xf_reg1_tank, 4.156921938165305, 2.4, 1666.0, 1666.0, 0.005, xf_reg1_2_A, xf_reg1_2_N

# x in percent on winding 1's kVA (every coil's baseS) at the From winding's baseU
Table TransformerMeshImpedance: mRID, FromWinding, ToWinding, x (percent)
    xf_reg1_mesh_12, xf_reg1_wdg_1, xf_reg1_wdg_2, 0.01
