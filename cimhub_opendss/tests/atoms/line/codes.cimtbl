# OpenDSS Line -> ACLineSegment (by LineCode, LineGeometry or its own impedance) or a Switch
# (Fuse / Recloser / LoadBreakSwitch by the control that switches it; DSS-9).
# Source table: Line (records: 10)
# Mapping: cimhub_opendss/docs/CIMTBL_MAPPING.md#line-and-switches

Profile = cim18v17

Table PerLengthPhaseImpedance: mRID, name, conductorCount, calculatedFrequency (Hz), isTemplate
    # derived from a 1-phase sequence code: z = Z1 (phase_matrix); a 1-phase line does not use r0=0.9, x0=2.1, C0=1.6
    # synthesized: the inline values of Line seq3
    # units inferred: km (median r 0.5 per unit over 1 code; no units on code or line)
    # defaulted: C1=3.4, C0=1.6
    # defaulted: baseFreq=60.0
    ln_seq3_lc, seq3, 1, 60.0, false

# units=km. row/column are conductor indices of the lower triangle.
# derived: b = 2 pi baseFreq C (b_from_c), from cmatrix (nF) -> nS; 1- and 2-phase sequence codes: r, x, C by phase_matrix (DSS-4)
Table PhaseImpedanceData: identifier, PhaseImpedance, row, column, r (ohm/km), x (ohm/km), b (nS/km)
    ln_seq3_lc_11, ln_seq3_lc, 1, 1, 0.5, 0.9, 1281.7698026646356

# derived: bch/b0ch = 2 pi baseFreq C1/C0 (b_from_c), from C (nF) -> nS
Table PerLengthSequenceImpedance: mRID, name, r (ohm/km), x (ohm/km), r0 (ohm/km), x0 (ohm/km), calculatedFrequency (Hz), bch (nS/km), b0ch (nS/km), isTemplate
    # synthesized: the inline values of Line seq1
    # defaulted: baseFreq=60.0
    ln_seq1_lc, seq1, 0.3, 0.6, 0.6, 1.8, 60.0, 3769.9111843077517, 1507.9644737231006, false

# derived: bch/b0ch = 2 pi baseFreq C1/C0 (b_from_c), from C (nF) -> nS
Table PerLengthSequenceImpedance: mRID, name, r (ohm/km), x (ohm/km), r0 (ohm/km), x0 (ohm/km), calculatedFrequency (Hz), bch (nS/kft), b0ch (nS/kft), isTemplate
    # synthesized: the inline values of Line seq2
    # defaulted: r0=0.1784, x0=0.4047, C1=3.4, C0=1.6
    # defaulted: baseFreq=60.0
    ln_seq2_lc, seq2, 0.3, 0.6, 0.1784, 0.4047, 60.0, 1281.7698026646356, 603.1857894892403, false

