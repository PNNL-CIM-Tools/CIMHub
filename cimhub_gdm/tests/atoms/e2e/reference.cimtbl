# --- transformer catalogs (sub5000, xfm500; reg1666 for the regulators) -------------------------------------------
# derived: loadLoss = pct / 100 x winding 1 kVA: 0.001 % of 5000 = 0.05 kW; 1.1 % of 500 = 5.5 kW
Table TransformerTankConfiguration: mRID, name, noLoadLoss (kW), loadLoss (kW)
    xc_sub5000, sub5000, 0, 0.05
    xc_xfm500,  xfm500,  0, 5.500000000000001
    xc_reg1666, reg1666, 0, 0

