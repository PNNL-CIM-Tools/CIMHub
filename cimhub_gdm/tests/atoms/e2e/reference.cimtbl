    xc_xfm500_end_2,  xc_xfm500,  2, Y
    xc_reg1666_end_1, xc_reg1666, 1, Y
    xc_reg1666_end_2, xc_reg1666, 2, Y

# derived: ratedU 2.4018 x sqrt 3 = 4.16004 kV, 0.27713 x sqrt 3 = 0.480003 kV; baseU the coil; baseS = kVA / phases
