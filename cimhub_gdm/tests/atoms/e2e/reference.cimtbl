# reference_system(): an IEEE13-like system with every family on one feeder (TEST_DESIGN.md, Phase 5). Self-contained:
# no prereq import. Each family follows its atom's rules (tests/atoms/<family>); the comments give the derived values.

Profile = cim18v17
Authority = https://github.com/PNNL-CIM-Tools/CIMHub
Model = ieee13

# --- shell ---------------------------------------------------------------------------------------------------------
Object Substation: mRID=sub_sub, name=sub
Object Feeder: mRID=fdr_ieee13, name=ieee13, NormalEnergizingSubstation=sub_sub
Object BaseFrequency: mRID=base_freq, frequency (Hz)=60

Table BaseVoltage: mRID, nominalVoltage (kV)
    bv_115kv,  115
    bv_4p16kv, 4.16
    bv_480v,   0.48

Table ConnectivityNode: mRID, name, BaseVoltage, ConnectivityNodeContainer=fdr_ieee13
    sourcebus, sourcebus, bv_115kv
    650,       650,       bv_4p16kv
    rg60,      rg60,      bv_4p16kv
    632,       632,       bv_4p16kv
    633,       633,       bv_4p16kv
    634,       634,       bv_480v
    645,       645,       bv_4p16kv
    646,       646,       bv_4p16kv
    671,       671,       bv_4p16kv
    680,       680,       bv_4p16kv
    684,       684,       bv_4p16kv
    611,       611,       bv_4p16kv
    652,       652,       bv_4p16kv
    692,       692,       bv_4p16kv
    675,       675,       bv_4p16kv

