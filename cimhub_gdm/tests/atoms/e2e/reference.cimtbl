    xc_sub5000_wdg_2, xc_sub5000, 4.16003962961893,    2.4018,  5000, 1666.6666666666667, 0.0005, xc_sub5000_end_2
    xc_xfm500_wdg_1,  xc_xfm500,  4.16003962961893,    2.4018,  500,  166.66666666666666, 0.55,   xc_xfm500_end_1
    xc_xfm500_wdg_2,  xc_xfm500,  0.48000324030156294, 0.27713, 500,  166.66666666666666, 0.55,   xc_xfm500_end_2
