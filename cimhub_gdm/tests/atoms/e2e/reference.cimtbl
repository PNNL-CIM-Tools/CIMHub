# IEEE13's RegControl: 122 V band 2 V on PT 20 -> 2440 V, 40 V; R 3 V, X 9 V on CT 700 A -> 0.0857143, 0.257143 ohm;
# limits 110 / 130 V x 20. The controlled bus rg60 is end 2's.
Table TapChangerControl: mRID, name, mode=voltage, discrete=true, enabled=true, monitoredPhase, targetValue=2440, targetDeadband=40, lineDropCompensation=true, lineDropR (ohm)=0.08571428571428572, lineDropX (ohm)=0.2571428571428571, reversible=false, minLimitVoltage (V)=2200, maxLimitVoltage (V)=2600, Terminal
    vr_reg1_ctrl, reg1, A, vr_reg1_T2
    vr_reg2_ctrl, reg2, B, vr_reg2_T2
    vr_reg3_ctrl, reg3, C, vr_reg3_T2

# IEEE13's solved taps: step = (tap - 1) / 0.625 %: 1.0625 -> 10, 1.05 -> 8, 1.06875 -> 11
Table RatioTapChanger: mRID, name, TransformerEnd, TapChangerControl, highStep=16, lowStep=-16, neutralStep=0, normalStep=0, step, stepVoltageIncrement (percent)=0.625, neutralU (kV)=2.4018, ltcFlag=true, controlEnabled=true, ptRatio=20, ctRating=700, initialDelay (s)=30, AssetDatasheet=tci_reg1666
    vr_reg1_tap, reg1, vr_reg1_end2, vr_reg1_ctrl, 10
    vr_reg2_tap, reg2, vr_reg2_end2, vr_reg2_ctrl, 8
    vr_reg3_tap, reg3, vr_reg3_end2, vr_reg3_ctrl, 11

