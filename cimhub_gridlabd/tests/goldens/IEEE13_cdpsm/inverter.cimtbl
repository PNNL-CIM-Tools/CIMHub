    pv_inv_pv_house_unit,  pv_house,  5000.0,   0.0, 999.9888055331668, pv_inv_pv_house_array,  pv_inv_pv_house
    # defaulted: NOCT=118.4, Rated_Insolation=92.902, Pmax_temp_coeff=-0.00012928994082840237, shading_factor=1.0,
    # tilt_angle=45.0, orientation_azimuth=180.0
    pv_inv_pv_school_unit, pv_school, 300000.0, 0.0, 999.9888055331668, pv_inv_pv_school_array, pv_inv_pv_school

# storedE = state_of_charge x capacity, minimumE = soc_reserve x capacity; efficiencies sqrt(round trip)
Table BatteryUnit: mRID, name, ratedE (Wh), storedE (Wh), minimumE (Wh), maxP (W), minP (W), chargingEfficiency (percent), dischargingEfficiency (percent), batteryState, AssetDatasheet, PowerElectronicsConnection, EquipmentContainer=fdr_IEEE13_cdpsm
    storage_inv_bat_batidle_unit, bat_batidle, 200000.0, 100000.0,          0.0, 100000.0, -100000.0, 92.73618495495704, 92.73618495495704, charging,    storage_inv_bat_batidle_battery, storage_inv_bat_batidle
    storage_inv_bat_house_unit,   bat_house,   13500.0,  5000.400000000001, 0.0, 5000.0,   -5000.0,   92.73618495495704, 92.73618495495704, charging,    storage_inv_bat_house_battery,   storage_inv_bat_house
    storage_inv_bat_school_unit,  bat_school,  200000.0, 100000.0,          0.0, 100000.0, -100000.0, 92.73618495495704, 92.73618495495704, discharging, storage_inv_bat_school_battery,  storage_inv_bat_school
