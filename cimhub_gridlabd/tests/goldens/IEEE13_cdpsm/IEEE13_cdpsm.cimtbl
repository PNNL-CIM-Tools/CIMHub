# GridLAB-D model IEEE13_cdpsm
# Mapping: cimhub_gridlabd/docs/CIMTBL_MAPPING.md#master
# not mapped: battery 3, capacitor 2, inverter 5, load 9, regulator 1, regulator_configuration 1, solar 2, transformer
# 3, transformer_configuration 3, triplex_load 1

Profile = cim18v17
Authority = https://github.com/PNNL-CIM-Tools/CIMHub
Model = IEEE13_cdpsm

Object Substation: mRID=sub_IEEE13_cdpsm, name=IEEE13_cdpsm

Object Feeder: mRID=fdr_IEEE13_cdpsm, name=IEEE13_cdpsm, NormalEnergizingSubstation=sub_IEEE13_cdpsm

# defaulted: powerflow::nominal_frequency=60.0
Object BaseFrequency: mRID=bf_60hz, frequency (Hz)=60.0

Table BaseVoltage: mRID, nominalVoltage (kV)
    bv_115kv,  115.0
    bv_4p16kv, 4.16
    bv_480v,   0.48
    bv_240v,   0.24

Table OperationalLimitType: mRID, name, durationKind, isInfiniteDuration, direction
    olt_normal,    normal,    normal,    true,  absoluteValue
    olt_emergency, emergency, emergency, false, absoluteValue

Import bus.cimtbl

Import source.cimtbl

Import line_configuration.cimtbl

Import overhead_line.cimtbl

Import switch.cimtbl

Import fuse.cimtbl

Import recloser.cimtbl
