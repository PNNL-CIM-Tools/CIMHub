# Mapping: cimhub_gridlabd/docs/CIMTBL_MAPPING.md#s3c-regulators
# no regulator names (not written): rc_unused

Profile = cim18v17

# one unit per wired phase (INDIVIDUAL) or a gang unit (BANK), GLM-7
Table VoltageRegulator: mRID, name, construction, EquipmentContainer=fdr_reg
    # configuration rc_bank
    # defaulted: dwell_time=0.0, Type=B, regulator_resistance=0.0001
    xf_reg_bank,     reg_bank,     typeB
    # configuration rc_ldc
    # defaulted: time_delay=0.0, dwell_time=0.0, control_level=INDIVIDUAL, Type=B
    xf_reg_ldc_A,    reg_ldc_A,    typeB
    # configuration rc_output
    # defaulted: control_level=INDIVIDUAL, Type=B, regulator_resistance=0.0001
    xf_reg_output_A, reg_output_A, typeB
    # configuration rc_output
    # defaulted: control_level=INDIVIDUAL, Type=B, regulator_resistance=0.0001
    xf_reg_output_B, reg_output_B, typeB
    # configuration rc_output
    # defaulted: control_level=INDIVIDUAL, Type=B, regulator_resistance=0.0001
    xf_reg_output_C, reg_output_C, typeB
    # configuration rcon_creg3c
    # defaulted: time_delay=0.0, control_level=INDIVIDUAL, regulator_resistance=0.0001
    xf_xf_reg3_A,    xf_reg3_A,    typeA
    # configuration rcon_creg3c
    # defaulted: time_delay=0.0, control_level=INDIVIDUAL, regulator_resistance=0.0001
    xf_xf_reg3_C,    xf_reg3_C,    typeA

