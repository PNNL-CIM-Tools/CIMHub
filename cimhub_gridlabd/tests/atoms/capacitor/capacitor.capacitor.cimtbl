# Mapping: cimhub_gridlabd/docs/CIMTBL_MAPPING.md#s4a-loads-and-capacitors

Profile = cim18v17

# a unit per set of phases that switch together (S4a-8); sections: the switch state GridLAB-D starts with, OPEN when unset (S4a-9)
