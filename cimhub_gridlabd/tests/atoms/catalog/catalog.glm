// spacings: distances and heights in ft; taxonomy distances in inches with a zero
object line_spacing {
  name "spc_601_ABCN";
  distance_AB 2.5;
  distance_AC 7.0;
  distance_AN 5.6569;
  distance_AE 28.0;
  distance_BC 4.5;
  distance_BN 4.272;
  distance_BE 28.0;
  distance_CN 5.0;
  distance_CE 28.0;
  distance_NE 24.0;
}
object line_spacing:10 {
  distance_AB 0.0 in;
  distance_AN 84.0 in;
}
object line_spacing { name "spc_607_AN"; distance_AN 0.0833; }

// configurations: geometry, a taxonomy geometry by alias, a mixed cable assembly, a 2-phase matrix
object line_configuration {
  name "lcon_601";
  spacing "spc_601_ABCN";
  conductor_A "wire_acsr_556_5";
  conductor_B "wire_acsr_556_5";
  conductor_C "wire_acsr_556_5";
  conductor_N "overhead_line_conductor:3";
}
object line_configuration:18 {
  conductor_A overhead_line_conductor:3;
  conductor_N overhead_line_conductor:3;
  spacing line_spacing:10;
}
object line_configuration {
  name "lcon_607";
  spacing "spc_607_AN";
  conductor_A "tscab_ts_1/0";
  conductor_N "ugwire_cu_1/0";
}
object line_configuration {
