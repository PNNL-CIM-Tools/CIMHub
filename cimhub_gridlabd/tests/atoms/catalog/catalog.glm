// S2 atom: every catalog form. Values from IEEE13_assets (the Java export) and orig_R1-12.47-3 (taxonomy).
module powerflow { solver_method NR; }

object substation { name src; bustype SWING; phases ABCN; nominal_voltage 2401.78; }
object node { name n1; phases ABCN; nominal_voltage 2401.78; }
object overhead_line { name l1; phases ABCN; from src; to n1; length 500; configuration lcon_601; }

// overhead: a rated conductor with a diameter, and a taxonomy one (summer continuous only, an inline unit)
object overhead_line_conductor {
  name "wire_acsr_556_5";
  geometric_mean_radius 0.031100;
  diameter 0.927000;
  resistance 0.189720;
  rating.summer.continuous 730.00;
  rating.summer.emergency 730.00;
  rating.winter.continuous 730.00;
  rating.winter.emergency 730.00;
}
object overhead_line_conductor:3 {
  rating.summer.continuous 334.0;
  geometric_mean_radius 0.00814 ft;
  resistance 0.56300;
}

// underground: concentric neutral, tape shield, and a bare wire (the 607 neutral)
