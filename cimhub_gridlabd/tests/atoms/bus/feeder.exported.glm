clock {
  timezone UTC0;
  starttime '2000-01-01 00:00:00';
  stoptime '2000-01-01 00:00:00';
}
#set relax_naming_rules=1
module powerflow {
  solver_method NR;
  nominal_frequency 60;
  line_capacitance TRUE;
}
object line_configuration {
  name "lc_1";
  z11 0.3+1j;
  z12 0+0j;
  z13 0+0j;
  z21 0+0j;
  z22 0.3+1j;
  z23 0+0j;
  z31 0+0j;
  z32 0+0j;
  z33 0.3+1j;
  c11 0;
  c12 0;
  c13 0;
  c21 0;
  c22 0;
  c23 0;
  c31 0;
  c32 0;
  c33 0;
}
object transformer_configuration {
  name "xc_3ph";
  connect_type "WYE_WYE";
  primary_voltage 12470;
  secondary_voltage 480;
  power_rating 75;
  impedance 0.015+0.01j;
}
object transformer_configuration {
  name "xc_ct";
  connect_type "SINGLE_PHASE_CENTER_TAPPED";
  primary_voltage 7200;
  secondary_voltage 120;
  power_rating 25;
  powerA_rating 25;
  impedance 0.003+0.01088j;
  impedance1 0.006+0.00544j;
  impedance2 0.006+0.00544j;
}
object substation {
  name "sourcebus";
  phases "ABCN";
  nominal_voltage 7200;
  bustype "SWING";
  positive_sequence_voltage 7200+0j;
  base_power 12000000;
}
object node {
  name "meter_1";
  phases "ABCN";
  nominal_voltage 277.12812921102;
}
object node {
  name "n1";
  phases "ABCN";
  nominal_voltage 7199.55785679463;
}
object triplex_node {
  name "tm_1";
  phases "AS";
  nominal_voltage 120;
}
object overhead_line {
  name "l1";
  phases "ABC";
  from "sourcebus";
  to "n1";
  configuration "lc_1";
  length 100;
}
object transformer {
  name "xf_3ph";
  phases "ABCN";
  from "n1";
  to "meter_1";
  configuration "xc_3ph";
}
object transformer {
  name "xf_ct";
  phases "AS";
  from "n1";
  to "tm_1";
  configuration "xc_ct";
}
object load {
  name "ld_1";
  parent "n1";
  phases "AN";
  nominal_voltage 7199.55785679463;
}
object triplex_load {
  name "tn_1";
  parent "tm_1";
  phases "AS";
  nominal_voltage 120;
  base_power_12 1581.13883008419;
  power_pf_12 0.948683298050514;
  power_fraction_12 1;
}
