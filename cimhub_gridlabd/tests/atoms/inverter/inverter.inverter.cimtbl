    storage_inv_boff_unit,  boff,  100000.0, 50000.0,  0.0,     60000.0,  -60000.0,  89.44271909999159, 89.44271909999159, waiting,     storage_inv_boff_battery,  storage_inv_boff
    storage_inv_bpf_unit,   bpf,   13500.0,  4995.0,   0.0,     5000.0,   -5000.0,   92.73618495495704, 92.73618495495704, charging,    storage_inv_bpf_battery,   storage_inv_bpf
    # defaulted: nominal_voltage=115.0, round_trip_efficiency=0.8
    storage_inv_bres_unit,  bres,  40000.0,  10000.0,  10000.0, 10000.0,  -10000.0,  89.44271909999159, 89.44271909999159, waiting,     storage_inv_bres_battery,  storage_inv_bres
