    # defaulted: nominal_voltage=115.0, round_trip_efficiency=0.8
    storage_inv_bfull_unit, bfull, 50000.0,  50000.0,  0.0,     30000.0,  -30000.0,  89.44271909999159, 89.44271909999159, waiting,     storage_inv_bfull_battery, storage_inv_bfull
