    pv_inv_pv1_unit, pv1, 8000.0,   0.0, 999.9888055331668, pv_inv_pv1_array, pv_inv_pv1
    # defaulted: NOCT=118.4, Rated_Insolation=92.902, Pmax_temp_coeff=-0.00012307692307692307, efficiency=0.15,
    # soiling=0.95, derating=0.95
    pv_inv_pv3_unit, pv3, 250000.0, 0.0, 799.9910444265334, pv_inv_pv3_array, pv_inv_pv3
    # defaulted: panel_type=SINGLE_CRYSTAL_SILICON, NOCT=118.4, Rated_Insolation=92.902,
    # Pmax_temp_coeff=-0.00012928994082840237, shading_factor=1.0, tilt_angle=45.0, orientation_azimuth=180.0
    pv_inv_pvs_unit, pvs, 6000.0,   0.0, 999.9888055331668, pv_inv_pvs_array, pv_inv_pvs

# storedE = state_of_charge x capacity, minimumE = soc_reserve x capacity; efficiencies sqrt(round trip)
Table BatteryUnit: mRID, name, ratedE (Wh), storedE (Wh), minimumE (Wh), maxP (W), minP (W), chargingEfficiency (percent), dischargingEfficiency (percent), batteryState, AssetDatasheet, PowerElectronicsConnection, EquipmentContainer=fdr_atom
