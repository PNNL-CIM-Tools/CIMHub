# Shape: series compensator (an OpenDSS series Reactor) between two nodes. r and x are per phase in ohm; with no
# mutual coupling the zero-sequence values equal them. SeriesCompensator has no per-phase class, so an Update
# gives its generated Terminals their phases. Its ratings are an OperationalLimitSet, as a line's.

Profile = cim18v17

Import common.cimtbl

Table SeriesCompensator: mRID, name, node1, node2, r (ohm), x (ohm), r0 (ohm), x0 (ohm), BaseVoltage, EquipmentContainer=fdr_shapes
    rx_hsb, hsb, n0, n1, 0, 14.798307, 0, 14.798307, bv_4p16kv

Update Table Terminal: mRID, phases
    rx_hsb_T1, ABC
    rx_hsb_T2, ABC

Object OperationalLimitSet: mRID=rx_hsb_limits, Equipment=rx_hsb
Table CurrentLimit: mRID, normalValue (A), OperationalLimitType, OperationalLimitSet
    rx_hsb_norm,  400, olt_normal,    rx_hsb_limits
    rx_hsb_emerg, 400, olt_emergency, rx_hsb_limits
