# Shape: equipment coordinates (a DSS BusCoords/LatLongCoords file, a GLM node's latitude/longitude, a GIS
# line's polyline), drawn as a GIS draws them. Each ConductingEquipment gets one Location through the wkt
# column: a line is a LINESTRING from its first Terminal's bus to its last; any other equipment is one POINT, at
# its bus for one Terminal and at its buses' centroid for more (a switch or transformer midway). cimtables makes
# the Location (<mRID>_loc) and a PositionPoint per vertex; the Location takes the CoordinateSystem declared
# first. An Update on the abstract PowerSystemResource reaches any equipment, so this is written after every
# equipment file.

Profile = cim18v17

Import common.cimtbl

Table SeriesCompensator: mRID, name, node1, node2, r (ohm), x (ohm), BaseVoltage, EquipmentContainer=fdr_shapes
    rx_hsb, hsb, n0, n1, 0, 14.798307, bv_4p16kv
Table ACLineSegment: mRID, name, node1, node2, r (ohm), x (ohm), BaseVoltage, EquipmentContainer=fdr_shapes
    ln_y, y, n1, n2, 0.1, 0.2, bv_4p16kv
Table EnergyConsumer: mRID, name, node, p (kW), q (kVAr), BaseVoltage, EquipmentContainer=fdr_shapes
    ld_y1, y1, n2, 1155, 660, bv_4p16kv

Object CoordinateSystem: mRID=crs_bus, name=BusCoords, crsUrn=OpenDSSLocalBusCoordinates

Update Table PowerSystemResource: mRID, wkt
    rx_hsb, "POINT (200.0 375.0)"
    ln_y,   "LINESTRING (200.0 350.0, 250.0 300.0)"
    ld_y1,  "POINT (250.0 300.0)"
