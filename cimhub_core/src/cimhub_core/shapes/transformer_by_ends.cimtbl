# Shape: transformer by balanced ends, for formats without catalogs. Ratings and r on each
# PowerTransformerEnd (percent on the end's ratedU^2/ratedS), x on the mesh (percent on the From end).

Profile = cim18v17

Import common.cimtbl

Object PowerTransformer: mRID=xf_sub, name=sub, vectorGroup=Dyn1, EquipmentContainer=sub_shapes
Table PowerTransformerEnd: mRID, node, phases, endNumber, connectionKind, grounded, rground (ohm), xground (ohm), ratedU (kV), ratedS (kVA), r (percent), BaseVoltage, PowerTransformer=xf_sub
    xf_sub_1, sourcebus, ABC,  1, D,  false, ,  ,    115,  5000, 0.5, bv_115kv
    xf_sub_2, n0,        ABCN, 2, Yn, true,  0, 0.4, 4.16, 5000, 0.5, bv_4p16kv
Object TransformerMeshImpedance: mRID=xf_sub_mesh_12, FromTransformerEnd=xf_sub_1, ToTransformerEnd=xf_sub_2, x (percent)=8
