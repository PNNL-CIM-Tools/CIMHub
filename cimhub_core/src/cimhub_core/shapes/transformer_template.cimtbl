Profile = cim18v17

Object TransformerTankConfiguration: mRID=xc_xfm1, name=XFM1, percentImpedance=2.2825, percentMagnetizingCurrent=0, noLoadLoss (kW)=0

Table TransformerTankEnd: mRID, endNumber, phases, connectionKind, grounded, rground (ohm), xground (ohm), TankConfiguration=xc_xfm1
