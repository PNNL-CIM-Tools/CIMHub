# Shape: load. EnergyConsumer on a node with its phases and connection; its BaseVoltage is its node's. The ZIP
# models are the shared LoadResponseCharacteristics (common, from cimhub_core.load_response); an exponential model
# is a row of the spoke's own, written before the loads that name it. CIM load sign: consumption is positive p.
# On a split-phase secondary, s1s2 wye is two 120 V legs to neutral; s1 is one leg.
# A balanced three-phase device leaves phases blank: no per-phase children, CIM's three-phase default.

Profile = cim18v17

Import common.cimtbl

Table LoadResponseCharacteristic: mRID, exponentModel, pVoltageExponent, qVoltageExponent
    exp_0.8_3, true, 0.8, 3

Table EnergyConsumer: mRID, name, node, phases, phaseConnection, grounded, p (kW), q (kVAr), customerCount, LoadResponse, BaseVoltage, EquipmentContainer=fdr_shapes
    ld_y1, y1, n1,        ,  Y, true,  1155, 660, 1, zip_constant_pq, bv_4p16kv
    ld_d1, d1, n3,    BC,   D, false, 170,  80,  1, zip_constant_z,  bv_4p16kv
    ld_c1, c1, n3,    C,    Y, true,  170,  80,  1, zip_constant_i,  bv_4p16kv
    ld_s1, s1, house, s1s2, Y, true,  5,    1,   1, exp_0.8_3,       bv_240v
    ld_s2, s2, house, s2,   Y, true,  2,    0.5, 3, zip_constant_pq, bv_240v
